<!--
    Light palette. Same keys as Palette.Dark.xaml; see that file for what
    each one is for. Contrast ratios are against the white cards (Surface1).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ══════════ Brand palette ══════════
         Fills keep the same army green (white text on it is 4.7:1). The
         light olive used for text on dark cards would vanish on white, so
         AccentTextColor is a deep olive here (6.7:1). -->
    <Color x:Key="AccentColor">#617D2E</Color>
    <Color x:Key="AccentColorLight1">#6A8833</Color>
    <Color x:Key="AccentColorLight2">#789640</Color>
    <Color x:Key="AccentColorDark1">#5A7429</Color>
    <Color x:Key="AccentColorDark2">#4B5320</Color>
    <Color x:Key="AccentTextColor">#4A6420</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentColorLight1}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentColorDark1}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />

    <!-- Channel matrix colors -->
    <Color x:Key="ActiveSpeakerColor">#617D2E</Color>
    <Color x:Key="IdleSpeakerColor">#E3E6EB</Color>
    <SolidColorBrush x:Key="ActiveSpeakerBrush" Color="{StaticResource ActiveSpeakerColor}" />
    <SolidColorBrush x:Key="IdleSpeakerBrush" Color="{StaticResource IdleSpeakerColor}" />
    <SolidColorBrush x:Key="ChannelActiveTextBrush" Color="White" />
    <SolidColorBrush x:Key="ChannelIdleTextBrush" Color="#565C66" />

    <!-- ══════════ Surfaces ══════════
         Cool light grey page, white cards, soft grey insets. -->
    <SolidColorBrush x:Key="Surface0Brush" Color="#EDEFF2" />
    <SolidColorBrush x:Key="Surface1Brush" Color="#FFFFFF" Opacity="0.92" />
    <SolidColorBrush x:Key="Surface2Brush" Color="#E8EBEF" Opacity="0.90" />
    <SolidColorBrush x:Key="NavBrush"      Color="#EDEFF2" />
    <SolidColorBrush x:Key="StatusBarBrush" Color="#E4E7EB" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#C9CED6" Opacity="0.8" />
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#B3B9C2" />
    <sys:Double x:Key="CardShadowOpacity">0.08</sys:Double>

    <SolidColorBrush x:Key="HeosPanelBrush" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="HeosTileBrush" Color="#E9ECF0" />
    <SolidColorBrush x:Key="ArtworkChipBrush" Color="#CC1A1C20" />
    <!-- Tray widget: translucent over the Acrylic backdrop -->
    <SolidColorBrush x:Key="WidgetBackgroundBrush" Color="#E6F5F6F8" />

    <Color x:Key="ApplicationBackgroundColor">#EDEFF2</Color>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#EDEFF2" />
    <SolidColorBrush x:Key="WindowBackground" Color="#EDEFF2" />
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#F5F6F8" />

    <!-- ══════════ Text ══════════
         Near-black ramp on white: 18.5:1, 10.5:1, 5.8:1 and a disabled grey. -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111418" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#3A4049" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#5F6670" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#9AA0A9" />

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#111418" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#3A4049" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#5F6670" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#9AA0A9" />
</ResourceDictionary>
