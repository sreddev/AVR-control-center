<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:AvrRemote.Converters">

    <!-- Colours live in Palette.Dark.xaml / Palette.Light.xaml, merged before
         this file. Only styles and converters are defined here. -->

    <!-- ══════════ Converters ══════════ -->
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    <conv:BoolToColorConverter x:Key="ChannelBg"
                               TrueBrush="{StaticResource ActiveSpeakerBrush}"
                               FalseBrush="{StaticResource IdleSpeakerBrush}" />
    <conv:BoolToColorConverter x:Key="ChannelFg"
                               TrueBrush="{StaticResource ChannelActiveTextBrush}"
                               FalseBrush="{StaticResource ChannelIdleTextBrush}" />
    <conv:VolumeLabelConverter x:Key="VolumeLabel" />
    <conv:BoolToOpacityConverter x:Key="OperableOpacity" />
    <conv:NotNullToBoolConverter x:Key="NotNullToBool" />
    <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis" />
    <conv:ZeroToVisibleConverter x:Key="ZeroToVisible" />
    <conv:NotZeroToVisibleConverter x:Key="NotZeroToVisible" />
    <conv:EmptyToVisibleConverter x:Key="EmptyToVisible" />
    <conv:FolderIconConverter x:Key="FolderIcon" />
    <conv:ViewWidthConverter x:Key="ViewWidth" />
    <conv:ViewHeightConverter x:Key="ViewHeight" />
    <conv:MuteIconConverter x:Key="MuteIcon" />
    <conv:MuteBrushConverter x:Key="MuteBrush"
                             MutedBrush="{StaticResource AccentTextBrush}"
                             NormalBrush="{StaticResource TextPrimaryBrush}" />
    <conv:PlayPauseIconConverter x:Key="PlayPauseIcon" />
    <conv:HeosStatusConverter x:Key="HeosStatus" />
    <conv:AvailableBrushConverter x:Key="AvailableBrush"
                                  AvailableBrush="{StaticResource TextPrimaryBrush}"
                                  UnavailableBrush="{StaticResource TextTertiaryBrush}" />

    <!-- ══════════ Typography ══════════ -->
    <FontFamily x:Key="UiFont">Segoe UI Variable, Segoe UI, Segoe UI Emoji</FontFamily>

    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="MetricValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ══════════ Card ══════════ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface1Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="18"
                    Direction="270"
                    Opacity="{StaticResource CardShadowOpacity}"
                    ShadowDepth="4"
                    Color="Black" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InsetCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        <Setter Property="Effect" Value="{x:Null}" />
    </Style>

    <!-- Small pill for the signal / speaker matrix -->
    <Style x:Key="ChannelChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ══════════ Default TextBlock ══════════
         Applies our contrast to every unstyled TextBlock so the pages read
         well even before per-element styling. -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>
</ResourceDictionary>
