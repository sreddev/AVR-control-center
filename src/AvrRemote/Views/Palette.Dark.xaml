<!--
    Dark palette (the default). Every colour the app paints with lives here
    or in Palette.Light.xaml; both define the same keys. App.xaml.cs swaps
    this dictionary for the light one at startup when the user picks Light.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ══════════ Brand palette ══════════
         Army green. Two roles, because no single olive is readable both ways:
         AccentColor fills buttons/chips under white text (4.7:1, as bright
         as the fill can go while white text stays above WCAG AA 4.5:1), while
         AccentTextColor is for text, outlines and thin lines drawn on the
         dark cards (9.8:1 on Surface1). -->
    <Color x:Key="AccentColor">#617D2E</Color>
    <Color x:Key="AccentColorLight1">#6A8833</Color>
    <Color x:Key="AccentColorLight2">#789640</Color>
    <Color x:Key="AccentColorDark1">#5A7429</Color>
    <Color x:Key="AccentColorDark2">#4B5320</Color>
    <Color x:Key="AccentTextColor">#B8CC6E</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentColorLight1}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentColorDark1}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />

    <!-- Channel matrix colors -->
    <Color x:Key="ActiveSpeakerColor">#617D2E</Color>
    <Color x:Key="IdleSpeakerColor">#2F3238</Color>
    <SolidColorBrush x:Key="ActiveSpeakerBrush" Color="{StaticResource ActiveSpeakerColor}" />
    <SolidColorBrush x:Key="IdleSpeakerBrush" Color="{StaticResource IdleSpeakerColor}" />
    <SolidColorBrush x:Key="ChannelActiveTextBrush" Color="White" />
    <SolidColorBrush x:Key="ChannelIdleTextBrush" Color="#9096A0" />

    <!-- ══════════ Surfaces ══════════
         True-black base. Cards are a cool near-black (#121418 once blended
         over the page), so they separate from the background by tone and
         border. Surface1/2 stay slightly transparent for the HEOS art blur. -->
    <SolidColorBrush x:Key="Surface0Brush" Color="#000000" />
    <SolidColorBrush x:Key="Surface1Brush" Color="#14161B" Opacity="0.85" />
    <SolidColorBrush x:Key="Surface2Brush" Color="#1B1E25" Opacity="0.80" />
    <SolidColorBrush x:Key="NavBrush"      Color="#000000" />
    <SolidColorBrush x:Key="StatusBarBrush" Color="#08090B" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2C313A" Opacity="0.7" />
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#3A4049" />
    <sys:Double x:Key="CardShadowOpacity">0.35</sys:Double>

    <!-- HEOS page: translucent panels over the blurred cover art, tiles inside
         them, and the dark chips drawn over artwork (always dark, white icon). -->
    <SolidColorBrush x:Key="HeosPanelBrush" Color="#88141820" />
    <SolidColorBrush x:Key="HeosTileBrush" Color="#50202430" />
    <SolidColorBrush x:Key="ArtworkChipBrush" Color="#CC1A1C20" />
    <!-- Tray widget: translucent over the Acrylic backdrop -->
    <SolidColorBrush x:Key="WidgetBackgroundBrush" Color="#CC0E1015" />

    <!-- WPF-UI's dark theme paints the window and page area in neutral greys
         (#202020 and #272727). Beside the cool cards they read brown, so
         they are replaced with the palette above. Palettes are merged after
         the WPF-UI theme, so these keys win. -->
    <Color x:Key="ApplicationBackgroundColor">#000000</Color>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="WindowBackground" Color="#000000" />
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#060708" />

    <!-- ══════════ Text ══════════
         WPF-UI's Dark theme ships primary text at ~0.9 alpha on Fluent black
         which loses contrast. We override the ramp with values tuned for
         legibility (WCAG 4.5:1+ on Surface0). -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C7CBD1" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8B919B" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#5A5F68" />

    <!-- WPF-UI Fluent brush names — overridden so every packaged control
         (buttons, toggles, cards, headers) inherits our contrast. -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C7CBD1" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8B919B" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5A5F68" />
</ResourceDictionary>
