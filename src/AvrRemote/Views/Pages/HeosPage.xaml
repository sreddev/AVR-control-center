<pages:PageBase
    x:Class="AvrRemote.Views.Pages.HeosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:AvrRemote.Views.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d">

    <pages:PageBase.Resources>
        <!-- Flat list row -->
        <Style x:Key="RowBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface2Brush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small pill -->
        <Style x:Key="MiniBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clickable metadata text -->
        <Style x:Key="LinkText" TargetType="TextBlock">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                    <Setter Property="TextDecorations" Value="Underline" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Draggable divider between panels -->
        <Style x:Key="Splitter" TargetType="GridSplitter">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <!-- Thin grip line, brightens on hover -->
                            <Border
                                x:Name="Grip"
                                Width="2"
                                Height="40"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{StaticResource CardBorderBrush}"
                                CornerRadius="1" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="{StaticResource AccentTextBrush}" />
                                <Setter TargetName="Grip" Property="Height" Value="70" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </pages:PageBase.Resources>

    <Grid Margin="18,12,18,12" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Blurred album art fills the entire page background -->
        <Rectangle
            Grid.RowSpan="2"
            IsHitTestVisible="False"
            Opacity="0.4"
            RadiusX="0"
            RadiusY="0">
            <Rectangle.Fill>
                <ImageBrush
                    ImageSource="{Binding Heos.NowPlayingImageUrl, TargetNullValue={x:Null}}"
                    Stretch="UniformToFill" />
            </Rectangle.Fill>
            <Rectangle.Effect>
                <BlurEffect Radius="30" />
            </Rectangle.Effect>
        </Rectangle>


        <!-- Full-page blurred album art background -->
        <Border
            Grid.RowSpan="2"
            Margin="-40"
            IsHitTestVisible="False">
            <Image
                Opacity="0.40"
                Source="{Binding Heos.NowPlayingImageUrl, TargetNullValue={x:Null}}"
                Stretch="UniformToFill">
                <Image.Effect>
                    <BlurEffect Radius="90" />
                </Image.Effect>
            </Image>
        </Border>

        <!-- â”€â”€ Header â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="HEOS" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Text="Network music, services and queue" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding Heos.IsAvailable, Converter={StaticResource ChannelBg}}" />
                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Heos.IsAvailable, Converter={StaticResource HeosStatus}}" />
            </StackPanel>
        </Grid>

        <!-- Resizable three-panel layout. MinWidth keeps every panel usable
             no matter how far the user drags a splitter. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColPlayer" Width="300" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="ColBrowse" Width="*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="ColQueue" Width="260" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- â•â•â•â•â•â• Panel 1: Now playing â•â•â•â•â•â• -->
            <Border Grid.Column="0" Background="#88141820" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

        <!-- Blurred album art fills the entire page background -->
        <Rectangle
            Grid.RowSpan="2"
            IsHitTestVisible="False"
            Opacity="0.4"
            RadiusX="0"
            RadiusY="0">
            <Rectangle.Fill>
                <ImageBrush
                    ImageSource="{Binding Heos.NowPlayingImageUrl, TargetNullValue={x:Null}}"
                    Stretch="UniformToFill" />
            </Rectangle.Fill>
            <Rectangle.Effect>
                <BlurEffect Radius="30" />
            </Rectangle.Effect>
        </Rectangle>


                    <!-- Album art: square, grows with the panel width -->
                    <Border
                        x:Name="ArtHolder"
                        Grid.Row="0"
                        Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
                        MaxHeight="420"
                        Background="#50202430"
                        CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Opacity="0.4" ShadowDepth="4" Color="Black" />
                        </Border.Effect>
                        <Grid>
                            <ui:SymbolIcon FontSize="52" Foreground="{StaticResource TextTertiaryBrush}" Symbol="MusicNote124" />
                            <Image Source="{Binding Heos.NowPlayingImageUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,12,0,0"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="{Binding Heos.NowPlayingTitle}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Heos.NowPlayingTitle}" />

                    <StackPanel Grid.Row="2" Margin="0,3,0,0">
                        <TextBlock FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" MouseLeftButtonUp="OnArtistClick" Style="{StaticResource LinkText}" Text="{Binding Heos.NowPlayingArtist}" ToolTip="Search for this artist" />
                        <TextBlock FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" MouseLeftButtonUp="OnAlbumClick" Style="{StaticResource LinkText}" Text="{Binding Heos.NowPlayingAlbum}" ToolTip="Search for this album" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <Slider
                            Height="16"
                            IsMoveToPointEnabled="True"
                            Maximum="{Binding Heos.DurationMs}"
                            Minimum="0"
                            ToolTip="Drag to seek forward or back"
                            ValueChanged="OnSeekChanged"
                            Value="{Binding Heos.PositionMs, Mode=OneWay}" />
                        <Grid Margin="0,3,0,0">
                            <TextBlock HorizontalAlignment="Left" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" Text="{Binding Heos.PositionText}" />
                            <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" Text="{Binding Heos.DurationText}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Margin="0,12,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                        <ui:Button Width="40" Height="40" Margin="0,0,8,0" Command="{Binding HeosPreviousCommand}" Icon="{ui:SymbolIcon Previous24}" ToolTip="Previous" />
                        <ui:Button Width="50" Height="50" Margin="0,0,8,0" Appearance="Primary" Command="{Binding HeosPlayPauseCommand}" ToolTip="Play / Pause">
                            <ui:SymbolIcon FontSize="19" Symbol="{Binding Heos.IsPlaying, Converter={StaticResource PlayPauseIcon}}" />
                        </ui:Button>
                        <ui:Button Width="40" Height="40" Command="{Binding HeosNextCommand}" Icon="{ui:SymbolIcon Next24}" ToolTip="Next" />
                    </StackPanel>

                    <!-- Technical info -->
                    <Border Grid.Row="5" Margin="0,12,0,0" Padding="11" VerticalAlignment="Bottom" Background="#50202430" CornerRadius="8">
                        <StackPanel>
                            <Grid Margin="0,0,0,5">
                                <TextBlock HorizontalAlignment="Left" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" Text="SOURCE" />
                                <TextBlock Margin="60,0,0,0" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding State.Main.SourceFriendly}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock HorizontalAlignment="Left" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" Text="FORMAT" />
                                <TextBlock Margin="60,0,0,0" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding State.AudioFormat}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock HorizontalAlignment="Left" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" Text="SAMPLE RATE" />
                                <TextBlock Margin="60,0,0,0" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding State.SampleRate}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid>
                                <TextBlock HorizontalAlignment="Left" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" Text="SURROUND" />
                                <TextBlock Margin="60,0,0,0" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding State.SurroundMode}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Account, right under the playback info -->
                    <Border Grid.Row="6" Margin="0,8,0,0" Padding="11" Background="#50202430" CornerRadius="8">
                        <StackPanel>
                            <Grid Visibility="{Binding Heos.IsSignedIn, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="9" Foreground="{StaticResource TextTertiaryBrush}" Text="HEOS ACCOUNT" />
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Heos.AccountUsername}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Heos.AccountUsername}" />
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding HeosSignOutCommand}" Content="Sign out" Style="{StaticResource MiniBtn}" />
                            </Grid>

                            <StackPanel Visibility="{Binding Heos.IsSignedIn, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="Sign in to HEOS" />
                                <TextBlock Margin="0,1,0,6" FontSize="9.5" Foreground="{StaticResource TextTertiaryBrush}" Text="Enables Tidal, TuneIn and favorites." TextWrapping="Wrap" />
                                <ui:TextBox x:Name="HeosUser" Margin="0,0,0,4" Padding="7,5" FontSize="11" PlaceholderText="HEOS email" />
                                <PasswordBox x:Name="HeosPass" Margin="0,0,0,6" Padding="7,5" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" KeyDown="OnPasswordKeyDown" />
                                <ui:Button HorizontalAlignment="Stretch" Appearance="Primary" Click="OnSignInClick" Content="Sign in" />
                                <TextBlock Margin="0,5,0,0" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Heos.AccountMessage}" TextWrapping="Wrap" Visibility="{Binding Heos.AccountMessage, Converter={StaticResource StringNotEmptyToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource Splitter}" ResizeBehavior="PreviousAndNext" />

            <!-- â•â•â•â•â•â• Panel 2: Browse / search â•â•â•â•â•â• -->
            <Border Grid.Column="2" Background="#88141820" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

        <!-- Blurred album art fills the entire page background -->
        <Rectangle
            Grid.RowSpan="2"
            IsHitTestVisible="False"
            Opacity="0.4"
            RadiusX="0"
            RadiusY="0">
            <Rectangle.Fill>
                <ImageBrush
                    ImageSource="{Binding Heos.NowPlayingImageUrl, TargetNullValue={x:Null}}"
                    Stretch="UniformToFill" />
            </Rectangle.Fill>
            <Rectangle.Effect>
                <BlurEffect Radius="30" />
            </Rectangle.Effect>
        </Rectangle>


                    <!-- Breadcrumb + navigation -->
                    <Grid Grid.Row="0" Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding HeosBackCommand}" Content="&#x2190;  Back" Style="{StaticResource MiniBtn}" ToolTip="Up one level" Visibility="{Binding Heos.CanGoBack, Converter={StaticResource BoolToVis}}" />
                        <Button Grid.Column="1" Margin="6,0,0,0" Command="{Binding HeosHomeCommand}" Content="Services" Style="{StaticResource MiniBtn}" ToolTip="Back to the service list" Visibility="{Binding Heos.CanGoBack, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Heos.CurrentLocation}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Heos.CurrentLocation}" />
                        <!-- Reveals the queue again when it is collapsed -->
                        <Button
                            x:Name="ShowQueueBtn"
                            Grid.Column="3"
                            Margin="6,0,0,0"
                            Click="OnToggleQueue"
                            Content="Queue &#x2192;"
                            Style="{StaticResource MiniBtn}"
                            ToolTip="Show the queue"
                            Visibility="Collapsed" />
                    </Grid>

                    <StackPanel Grid.Row="1" Visibility="{Binding Heos.CurrentLocation, Converter={StaticResource EmptyToVisible}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="Services" />
                                <TextBlock Margin="0,1,0,8" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Text="Pick a source to browse its catalog" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,0,0,8" Visibility="{Binding Heos.SearchOptions.Count, Converter={StaticResource NotZeroToVisible}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="SearchBox" Padding="9,6" FontSize="12" KeyDown="OnSearchKeyDown" PlaceholderText="Search this service..." />
                        <ComboBox x:Name="SearchKind" Grid.Column="1" MinWidth="92" Margin="6,0" DisplayMemberPath="Name" ItemsSource="{Binding Heos.SearchOptions}" SelectedIndex="0" />
                        <Button Grid.Column="2" Click="OnSearchClick" Content="Search" Style="{StaticResource MiniBtn}" />
                    </Grid>

                    <ProgressBar Grid.Row="2" Height="2" VerticalAlignment="Bottom" Foreground="{StaticResource AccentTextBrush}" IsIndeterminate="True" Visibility="{Binding Heos.IsBusy, Converter={StaticResource BoolToVis}}" />

                    <Grid Grid.Row="3">
                        <!-- Service picker: grid of square cards -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Heos.CurrentLocation, Converter={StaticResource EmptyToVisible}}">
                            <ItemsControl ItemsSource="{Binding Heos.Sources}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Width="120"
                                            Height="120"
                                            Margin="4"
                                            Click="OnSourceClick"
                                            Cursor="Hand"
                                            IsEnabled="{Binding Available}"
                                            Tag="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border
                                                        x:Name="Root"
                                                        Background="#50202430"
                                                        BorderBrush="{StaticResource CardBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="12">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

        <!-- Blurred album art fills the entire page background -->
        <Rectangle
            Grid.RowSpan="2"
            IsHitTestVisible="False"
            Opacity="0.4"
            RadiusX="0"
            RadiusY="0">
            <Rectangle.Fill>
                <ImageBrush
                    ImageSource="{Binding Heos.NowPlayingImageUrl, TargetNullValue={x:Null}}"
                    Stretch="UniformToFill" />
            </Rectangle.Fill>
            <Rectangle.Effect>
                <BlurEffect Radius="30" />
            </Rectangle.Effect>
        </Rectangle>

                                                            <Image
                                                                Grid.Row="0"
                                                                Margin="20,16,20,4"
                                                                VerticalAlignment="Center"
                                                                Source="{Binding ImageUrl, TargetNullValue={x:Null}}"
                                                                Stretch="Uniform" />
                                                            <TextBlock
                                                                Grid.Row="1"
                                                                Margin="6,0,6,8"
                                                                HorizontalAlignment="Center"
                                                                FontSize="11"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                                Text="{Binding Name}"
                                                                TextAlignment="Center"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentTextBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Browse results: GRID view -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Heos.CurrentLocation, Converter={StaticResource StringNotEmptyToVis}}">
                            <ItemsControl ItemsSource="{Binding Heos.Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Width="130"
                                            Height="140"
                                            Margin="3"
                                            Click="OnItemClick"
                                            Cursor="Hand"
                                            Tag="{Binding}"
                                            ToolTip="{Binding Name}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border
                                                        x:Name="Root"
                                                        Background="#50202430"
                                                        BorderBrush="{StaticResource CardBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

        <!-- Blurred album art fills the entire page background -->
        <Rectangle
            Grid.RowSpan="2"
            IsHitTestVisible="False"
            Opacity="0.4"
            RadiusX="0"
            RadiusY="0">
            <Rectangle.Fill>
                <ImageBrush
                    ImageSource="{Binding Heos.NowPlayingImageUrl, TargetNullValue={x:Null}}"
                    Stretch="UniformToFill" />
            </Rectangle.Fill>
            <Rectangle.Effect>
                <BlurEffect Radius="30" />
            </Rectangle.Effect>
        </Rectangle>

                                                            <Border Grid.Row="0" Margin="6,6,6,2" CornerRadius="6" Background="{StaticResource Surface1Brush}">
                                                                <Grid>
                                                                    <ui:SymbolIcon FontSize="18" Foreground="{StaticResource TextTertiaryBrush}" Symbol="{Binding IsContainer, Converter={StaticResource FolderIcon}}" />
                                                                    <Image Source="{Binding ImageUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                                                                </Grid>
                                                            </Border>
                                                            <!-- Queue button overlay -->
                                                            <Button
                                                                Grid.Row="0"
                                                                Width="26"
                                                                Height="26"
                                                                Margin="0,8,8,0"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                Background="#CC1A1C20"
                                                                BorderThickness="0"
                                                                Click="OnQueueClick"
                                                                Content="+"
                                                                Cursor="Hand"
                                                                FontSize="14"
                                                                FontWeight="Bold"
                                                                Foreground="White"
                                                                Tag="{Binding}"
                                                                ToolTip="Add to queue"
                                                                Visibility="{Binding IsPlayable, Converter={StaticResource BoolToVis}}" />
                                                            <StackPanel Grid.Row="1" Margin="6,2,6,6">
                                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock FontSize="9.5" Foreground="{StaticResource TextTertiaryBrush}" Text="{Binding Subtitle}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentTextBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter x:Name="QueueSplitter" Grid.Column="3" Style="{StaticResource Splitter}" ResizeBehavior="PreviousAndNext" />

            <!-- â•â•â•â•â•â• Panel 3: Queue (collapsible) â•â•â•â•â•â• -->
            <Border x:Name="QueuePanel" Grid.Column="4" Background="#88141820" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

        <!-- Blurred album art fills the entire page background -->
        <Rectangle
            Grid.RowSpan="2"
            IsHitTestVisible="False"
            Opacity="0.4"
            RadiusX="0"
            RadiusY="0">
            <Rectangle.Fill>
                <ImageBrush
                    ImageSource="{Binding Heos.NowPlayingImageUrl, TargetNullValue={x:Null}}"
                    Stretch="UniformToFill" />
            </Rectangle.Fill>
            <Rectangle.Effect>
                <BlurEffect Radius="30" />
            </Rectangle.Effect>
        </Rectangle>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="Queue" />
                            <TextBlock FontSize="10" Foreground="{StaticResource TextTertiaryBrush}">
                                <Run Text="{Binding Heos.Queue.Count, Mode=OneWay}" />
                                <Run Text="tracks" />
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Margin="0,0,5,0" VerticalAlignment="Center" Command="{Binding HeosClearQueueCommand}" Content="Clear" Style="{StaticResource MiniBtn}" />
                        <Button Grid.Column="2" VerticalAlignment="Center" Click="OnToggleQueue" Content="&#x2192;" Style="{StaticResource MiniBtn}" ToolTip="Hide the queue" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Heos.Queue}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="OnQueueItemClick" Style="{StaticResource RowBtn}" Tag="{Binding}" ToolTip="{Binding Title}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="42" Height="42" VerticalAlignment="Center" Background="#50202430" CornerRadius="6">
                                                <Image Source="{Binding ImageUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" Text="{Binding Artist}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</pages:PageBase>










