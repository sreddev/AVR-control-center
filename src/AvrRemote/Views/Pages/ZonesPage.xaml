<pages:PageBase
    x:Class="AvrRemote.Views.Pages.ZonesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:AvrRemote.Views.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,16">
            <TextBlock FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="Zones" />
            <TextBlock Margin="0,0,0,14" Style="{StaticResource Subtitle}" Text="Power, volume, input and sleep timer for each room." />

            <!-- One card per zone the receiver reports -->
            <ItemsControl ItemsSource="{Binding Zones}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,12,12"
                            Padding="20,16"
                            VerticalAlignment="Top"
                            Style="{StaticResource Card}"
                            Visibility="{Binding Zone.IsPresent, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <!-- Title + power -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse
                                            Width="9"
                                            Height="9"
                                            VerticalAlignment="Center"
                                            Fill="{Binding Zone.IsOn, Converter={StaticResource ChannelBg}}" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            FontSize="17"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            Text="{Binding Zone.DisplayName}" />
                                    </StackPanel>
                                    <ui:Button
                                        Grid.Column="1"
                                        Margin="0,0,6,0"
                                        Command="{Binding DataContext.ToggleZoneMuteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Zone}"
                                        ToolTip="Mute / unmute">
                                        <ui:SymbolIcon
                                            FontSize="16"
                                            Foreground="{Binding Zone.IsMuted, Converter={StaticResource MuteBrush}}"
                                            Symbol="{Binding Zone.IsMuted, Converter={StaticResource MuteIcon}}" />
                                    </ui:Button>
                                    <ui:Button
                                        Grid.Column="2"
                                        Appearance="Primary"
                                        Command="{Binding DataContext.ToggleZonePowerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Zone}"
                                        Icon="{ui:SymbolIcon Power24}"
                                        ToolTip="Power on / off" />
                                </Grid>

                                <!-- Volume -->
                                <TextBlock Margin="0,16,0,2" Style="{StaticResource Caption}" Text="VOLUME" />
                                <Grid IsEnabled="{Binding Zone.IsOn}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <Slider
                                        VerticalAlignment="Center"
                                        IsMoveToPointEnabled="True"
                                        LargeChange="1"
                                        Maximum="98"
                                        Minimum="0"
                                        SmallChange="0.5"
                                        Value="{Binding Zone.Volume, Mode=TwoWay, Delay=250}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{Binding Zone.IsMuted, Converter={StaticResource MuteBrush}}"
                                        Text="{Binding Zone.Volume, Converter={StaticResource VolumeLabel}}" />
                                </Grid>

                                <!-- Input -->
                                <TextBlock Margin="0,14,0,2" Style="{StaticResource Caption}" Text="INPUT" />
                                <ComboBox
                                    DisplayMemberPath="Caption"
                                    DropDownClosed="OnZoneSourcePicked"
                                    IsEnabled="{Binding Zone.IsOn}"
                                    ItemsSource="{Binding DataContext.VisibleSources, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    SelectedValue="{Binding Zone.Source, Mode=OneWay}"
                                    SelectedValuePath="Token"
                                    Tag="{Binding Zone}" />

                                <!-- Sleep timer, when the zone reports one -->
                                <StackPanel Visibility="{Binding Sleep.IsSupported, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Margin="0,14,0,2" Style="{StaticResource Caption}" Text="SLEEP TIMER" />
                                    <ComboBox ItemsSource="{Binding Sleep.Options}" SelectedItem="{Binding Sleep.Selected, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                Margin="0,0,0,12"
                FontSize="12"
                Foreground="{StaticResource TextTertiaryBrush}"
                Text="The connected receiver didn't report a Zone 2 or Zone 3. Extra zones appear here automatically on models that have them."
                TextWrapping="Wrap"
                Visibility="{Binding HasExtraZones, Converter={StaticResource InverseBoolToVis}}" />

            <ContentControl MaxWidth="560" HorizontalAlignment="Left" Content="{Binding ZoneOptions}" ContentTemplate="{StaticResource SettingSectionCard}" />

            <TextBlock
                FontSize="11"
                Foreground="{StaticResource TextTertiaryBrush}"
                Text="The power button on the status bar only wakes the main zone; Zone 2 is switched off with it. Turn extra zones on here."
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</pages:PageBase>
