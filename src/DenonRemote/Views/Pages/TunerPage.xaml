<pages:PageBase
    x:Class="DenonRemote.Views.Pages.TunerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:DenonRemote.Views.Pages"
    xmlns:services="clr-namespace:DenonRemote.Services"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d">

    <pages:PageBase.Resources>
        <Style x:Key="PillBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Band toggle: filled with the accent colour while that band is tuned -->
        <Style x:Key="FmBandBtn" TargetType="Button" BasedOn="{StaticResource PillBtn}">
            <Setter Property="MinWidth" Value="64" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State.TunerBand}" Value="FM">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AmBandBtn" TargetType="Button" BasedOn="{StaticResource PillBtn}">
            <Setter Property="MinWidth" Value="64" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State.TunerBand}" Value="AM">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TuneBtn" TargetType="Button" BasedOn="{StaticResource PillBtn}">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </pages:PageBase.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Static services:L.TunerTitle}" />
            <TextBlock Style="{StaticResource Subtitle}" Text="{x:Static services:L.TunerDesc}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- ── Left column: now tuned + manual tuning ─────────────────── -->
            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                <Border Margin="0,0,0,12" Padding="22" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Caption}" Text="{x:Static services:L.TunerNowTuned}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button
                                    Margin="0,0,6,0"
                                    Command="{Binding SetTunerBandCommand}"
                                    CommandParameter="FM"
                                    Content="FM"
                                    Style="{StaticResource FmBandBtn}" />
                                <Button
                                    Command="{Binding SetTunerBandCommand}"
                                    CommandParameter="AM"
                                    Content="AM"
                                    Style="{StaticResource AmBandBtn}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            FontSize="56"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="{Binding State.TunerFrequencyLabel}" />
                        <TextBlock
                            MinHeight="24"
                            HorizontalAlignment="Center"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource AccentBrush}"
                            Text="{Binding CurrentStationName}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="AUTO" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State.TunerAutoMode}" Value="False">
                                            <Setter Property="Text" Value="MANUAL" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Seek / step -->
                        <StackPanel Margin="0,18,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                            <Button Margin="0,0,8,0" Command="{Binding TuneSeekDownCommand}" Style="{StaticResource TuneBtn}" ToolTip="{x:Static services:L.TunerSeekDown}">
                                <ui:SymbolIcon FontSize="18" Symbol="Rewind24" />
                            </Button>
                            <Button Margin="0,0,8,0" Command="{Binding TuneStepDownCommand}" Style="{StaticResource TuneBtn}" ToolTip="{x:Static services:L.TunerStepDown}">
                                <ui:SymbolIcon FontSize="18" Symbol="ChevronLeft24" />
                            </Button>
                            <Button Margin="0,0,8,0" Command="{Binding TuneStepUpCommand}" Style="{StaticResource TuneBtn}" ToolTip="{x:Static services:L.TunerStepUp}">
                                <ui:SymbolIcon FontSize="18" Symbol="ChevronRight24" />
                            </Button>
                            <Button Command="{Binding TuneSeekUpCommand}" Style="{StaticResource TuneBtn}" ToolTip="{x:Static services:L.TunerSeekUp}">
                                <ui:SymbolIcon FontSize="18" Symbol="FastForward24" />
                            </Button>
                        </StackPanel>

                        <!-- Shown while another input is selected -->
                        <Border
                            Margin="0,18,0,0"
                            Padding="12,10"
                            Style="{StaticResource InsetCard}"
                            Visibility="{Binding IsTunerSource, Converter={StaticResource InverseBoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="{x:Static services:L.TunerNotActive}"
                                    TextWrapping="Wrap" />
                                <Button
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    Command="{Binding SwitchToTunerCommand}"
                                    Content="{x:Static services:L.TunerSwitchToTuner}"
                                    Style="{StaticResource PillBtn}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Manual tuning -->
                <Border Padding="18" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="{x:Static services:L.TunerManual}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox
                                Padding="11,9"
                                FontSize="13"
                                PlaceholderText="95.5 / 1010"
                                Text="{Binding ManualFrequency, UpdateSourceTrigger=PropertyChanged}">
                                <ui:TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding TuneToManualFrequencyCommand}" />
                                </ui:TextBox.InputBindings>
                            </ui:TextBox>
                            <ui:Button
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Stretch"
                                Appearance="Primary"
                                Command="{Binding TuneToManualFrequencyCommand}"
                                Content="{x:Static services:L.TunerTune}" />
                        </Grid>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="11"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            Text="{x:Static services:L.TunerManualHint}" />
                    </StackPanel>
                </Border>

                <TextBlock
                    Margin="4,12,0,0"
                    FontSize="12"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="{Binding TunerMessage}"
                    TextWrapping="Wrap"
                    Visibility="{Binding TunerMessage, Converter={StaticResource StringNotEmptyToVis}}" />
            </StackPanel>

            <!-- ── Right column: saved stations ───────────────────────────── -->
            <Border Grid.Column="1" Margin="6,0,0,0" Padding="18" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Static services:L.TunerSaved}" />
                            <TextBlock FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" Text="{x:Static services:L.TunerSavedDesc}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                            <Button Margin="0,0,6,0" Command="{Binding PreviousStationCommand}" Style="{StaticResource PillBtn}" ToolTip="{x:Static services:L.TunerPrevStation}">
                                <ui:SymbolIcon FontSize="14" Symbol="Previous24" />
                            </Button>
                            <Button Command="{Binding NextStationCommand}" Style="{StaticResource PillBtn}" ToolTip="{x:Static services:L.TunerNextStation}">
                                <ui:SymbolIcon FontSize="14" Symbol="Next24" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Stations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            x:Name="Row"
                                            Margin="0,0,0,6"
                                            Background="{StaticResource Surface2Brush}"
                                            BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Click tunes to the station -->
                                                <Button
                                                    Padding="12,8"
                                                    HorizontalContentAlignment="Stretch"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.PlayStationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                                                <ContentPresenter />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <StackPanel>
                                                        <TextBlock
                                                            FontSize="14"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource TextPrimaryBrush}"
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            x:Name="Freq"
                                                            FontSize="11"
                                                            Foreground="{StaticResource TextTertiaryBrush}">
                                                            <Run Text="{Binding Band, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding FrequencyLabel, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Button>
                                                <Button
                                                    Grid.Column="1"
                                                    Padding="6"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.EditStationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand"
                                                    Foreground="{StaticResource TextTertiaryBrush}"
                                                    ToolTip="{x:Static services:L.TunerEdit}">
                                                    <ui:SymbolIcon FontSize="15" Symbol="Edit24" />
                                                </Button>
                                                <Button
                                                    Grid.Column="2"
                                                    Margin="0,0,6,0"
                                                    Padding="6"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.DeleteStationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand"
                                                    Foreground="{StaticResource TextTertiaryBrush}"
                                                    ToolTip="{x:Static services:L.TunerDelete}">
                                                    <ui:SymbolIcon FontSize="15" Symbol="Delete24" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter TargetName="Freq" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="{x:Static services:L.TunerNoStations}"
                                TextWrapping="Wrap"
                                Visibility="{Binding Stations.Count, Converter={StaticResource ZeroToVisible}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Add / edit editor -->
                    <Border Grid.Row="2" Margin="0,12,0,0" Padding="14" Style="{StaticResource InsetCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding StationEditorTitle}" />
                            <ui:TextBox
                                Margin="0,0,0,8"
                                Padding="11,8"
                                FontSize="13"
                                PlaceholderText="{x:Static services:L.TunerName}"
                                Text="{Binding StationEditorName, UpdateSourceTrigger=PropertyChanged}">
                                <ui:TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SaveStationCommand}" />
                                </ui:TextBox.InputBindings>
                            </ui:TextBox>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox
                                    Padding="11,8"
                                    FontSize="13"
                                    PlaceholderText="{x:Static services:L.TunerFrequency}"
                                    Text="{Binding StationEditorFrequency, UpdateSourceTrigger=PropertyChanged}">
                                    <ui:TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding SaveStationCommand}" />
                                    </ui:TextBox.InputBindings>
                                </ui:TextBox>
                                <Button
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Command="{Binding UseCurrentFrequencyCommand}"
                                    Content="{x:Static services:L.TunerUseCurrent}"
                                    Style="{StaticResource PillBtn}" />
                            </Grid>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button
                                    Margin="0,0,8,0"
                                    Command="{Binding CancelStationEditCommand}"
                                    Content="{x:Static services:L.TunerCancel}"
                                    Style="{StaticResource PillBtn}"
                                    Visibility="{Binding IsEditingStation, Converter={StaticResource BoolToVis}}" />
                                <ui:Button
                                    Appearance="Primary"
                                    Command="{Binding SaveStationCommand}"
                                    Content="{x:Static services:L.TunerSave}"
                                    Icon="{ui:SymbolIcon Save24}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</pages:PageBase>
