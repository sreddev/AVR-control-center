<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AvrControlCenter.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- ══════════ Power indicator: dot + label pill ══════════ -->
    <Style TargetType="{x:Type controls:PowerIndicator}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PowerIndicator}">
                    <Border
                        Padding="8,3,10,3"
                        Background="{StaticResource Surface2Brush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse
                                x:Name="Dot"
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Fill="{StaticResource TextTertiaryBrush}"
                                Stroke="{StaticResource TextTertiaryBrush}"
                                StrokeThickness="0" />
                            <TextBlock
                                x:Name="Text"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="{TemplateBinding Label}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Power" Value="On">
                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource PowerOnBrush}" />
                            <Setter TargetName="Text" Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="Power" Value="Standby">
                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource PowerStandbyBrush}" />
                        </Trigger>
                        <Trigger Property="Power" Value="ZoneOnly">
                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource PowerStandbyBrush}" />
                        </Trigger>
                        <!-- Offline: hollow ring, nothing is known -->
                        <Trigger Property="Power" Value="Offline">
                            <Setter TargetName="Dot" Property="Fill" Value="Transparent" />
                            <Setter TargetName="Dot" Property="StrokeThickness" Value="1.5" />
                            <Setter TargetName="Text" Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsBusy" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="Pulse">
                                    <Storyboard>
                                        <DoubleAnimation
                                            AutoReverse="True"
                                            RepeatBehavior="Forever"
                                            Storyboard.TargetName="Dot"
                                            Storyboard.TargetProperty="Opacity"
                                            From="1"
                                            To="0.25"
                                            Duration="0:0:0.7" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Pulse" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════ Power button ══════════
         Filled while On, outlined in Standby, disabled (by the command) while
         offline, connecting or changing. Pulses while changing. -->
    <Style x:Key="PowerButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Secondary" />
        <Setter Property="ToolTip" Value="{Binding State.PowerLabel}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State.Power}" Value="On">
                <Setter Property="Appearance" Value="Primary" />
                <Setter Property="ToolTip" Value="On · click to put the receiver in standby" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State.Power}" Value="Standby">
                <Setter Property="ToolTip" Value="Standby · click to turn the receiver on" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State.Power}" Value="ZoneOnly">
                <Setter Property="ToolTip" Value="{Binding State.PowerLabel}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State.Power}" Value="TurningOn">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="PulseOn">
                        <Storyboard>
                            <DoubleAnimation AutoReverse="True" RepeatBehavior="Forever" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.6" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="PulseOn" />
                </DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding State.Power}" Value="GoingToStandby">
                <Setter Property="Appearance" Value="Primary" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="PulseOff">
                        <Storyboard>
                            <DoubleAnimation AutoReverse="True" RepeatBehavior="Forever" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.6" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="PulseOff" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Home header variant: the label follows the state too. -->
    <Style x:Key="PowerButtonLabeled" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource PowerButton}">
        <Setter Property="Content" Value="Power" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State.Power}" Value="Standby">
                <Setter Property="Content" Value="Turn on" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State.Power}" Value="ZoneOnly">
                <Setter Property="Content" Value="Turn on" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State.Power}" Value="TurningOn">
                <Setter Property="Content" Value="Turning on…" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State.Power}" Value="GoingToStandby">
                <Setter Property="Content" Value="Standby…" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ══════════ Power gate: banner + dimmed page ══════════ -->
    <Style TargetType="{x:Type controls:PowerGate}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PowerGate}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            x:Name="Banner"
                            Margin="20,16,20,0"
                            Padding="14,10"
                            Background="{StaticResource Surface2Brush}"
                            BorderBrush="{StaticResource StrongBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Visibility="Collapsed">
                            <Border.RenderTransform>
                                <TranslateTransform />
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <controls:PowerIndicator Label="{Binding State.PowerLabel}" Power="{Binding State.Power}" />
                                <TextBlock
                                    x:Name="Message"
                                    Grid.Column="1"
                                    Margin="12,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="Waiting for the receiver…"
                                    TextWrapping="Wrap" />
                                <ui:Button
                                    x:Name="TurnOn"
                                    Grid.Column="2"
                                    Appearance="Primary"
                                    Command="{Binding PowerToggleCommand}"
                                    Content="Turn on"
                                    Icon="{ui:SymbolIcon Power24}"
                                    Visibility="Collapsed" />
                                <ui:Button
                                    x:Name="PART_Devices"
                                    Grid.Column="2"
                                    Content="Open Devices"
                                    Icon="{ui:SymbolIcon PlugConnected24}"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <ContentPresenter x:Name="Body" Grid.Row="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding State.IsOperable}" Value="False">
                            <Setter TargetName="Banner" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Body" Property="IsEnabled" Value="False" />
                            <Setter TargetName="Body" Property="Opacity" Value="0.45" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Banner" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Banner" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-6" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State.Power}" Value="Standby">
                            <Setter TargetName="Banner" Property="BorderBrush" Value="{StaticResource PowerStandbyBrush}" />
                            <Setter TargetName="Message" Property="Text" Value="The receiver is in standby. Turn it on to change these settings." />
                            <Setter TargetName="TurnOn" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State.Power}" Value="ZoneOnly">
                            <Setter TargetName="Banner" Property="BorderBrush" Value="{StaticResource PowerStandbyBrush}" />
                            <Setter TargetName="Message" Property="Text" Value="Only another zone is on. Turn on the main zone to change these settings." />
                            <Setter TargetName="TurnOn" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State.Power}" Value="Offline">
                            <Setter TargetName="Message" Property="Text" Value="The receiver isn't responding. Check that it's plugged in and that Network Standby is on." />
                            <Setter TargetName="PART_Devices" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
