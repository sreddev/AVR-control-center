<pages:PageBase
    x:Class="AvrControlCenter.Views.Pages.SoundPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:AvrControlCenter.Controls"
    xmlns:pages="clr-namespace:AvrControlCenter.Views.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d">

    <pages:PageBase.Resources>
        <Style x:Key="PillBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentTextBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface1Brush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </pages:PageBase.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="Sound" />
            <TextBlock Style="{StaticResource Subtitle}" Text="Per-channel level, tone, subwoofer and profiles. Audyssey and surround settings are under Processing." />
        </StackPanel>

        <!-- Profiles bar -->
        <Border Grid.Row="1" Margin="0,0,0,12" Padding="16,12" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="PROFILES" />

                <!-- Saved profile chips -->
                <ItemsControl Grid.Column="1" Margin="14,0" VerticalAlignment="Center" ItemsSource="{Binding Profiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,6,0"
                                Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Click loads the profile; double-click switches to rename -->
                                    <Button
                                        Padding="12,6"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnLoadProfile"
                                        Cursor="Hand"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        MouseDoubleClick="OnRenameProfile"
                                        Tag="{Binding}"
                                        ToolTip="Click to load, double-click to rename">
                                        <Grid>
                                            <TextBlock x:Name="NameText" Text="{Binding Name}" />
                                            <TextBox
                                                x:Name="NameEdit"
                                                MinWidth="70"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                KeyDown="OnRenameKeyDown"
                                                LostFocus="OnRenameCommit"
                                                Tag="{Binding}"
                                                Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Visibility="Collapsed" />
                                        </Grid>
                                    </Button>
                                    <Button
                                        Padding="4,6,8,6"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        controls:Feedback.Confirm="True"
                                        Click="OnDeleteProfile"
                                        Cursor="Hand"
                                        Foreground="{StaticResource TextTertiaryBrush}"
                                        Tag="{Binding}"
                                        ToolTip="Delete">
                                        <ui:SymbolIcon FontSize="12" Symbol="Dismiss24" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button
                        Margin="0,0,6,0"
                        Command="{Binding NormalizeChannelsCommand}"
                        Content="Normalize"
                        Style="{StaticResource PillBtn}"
                        ToolTip="All channels to 0 dB" />
                    <Button
                        Command="{Binding SaveProfileCommand}"
                        Content="+ Save"
                        Style="{StaticResource PillBtn}"
                        ToolTip="Save current levels" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Two-column layout: channels on the left, tone + subwoofer on the right -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Channel levels -->
            <Border Grid.Column="0" Margin="0,0,6,0" Padding="18" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="Channel levels" />
                        <TextBlock FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" Text="Fine trim for each speaker (-12 to +12 dB)" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding ActiveChannels}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="62" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Width="44"
                                                Height="24"
                                                VerticalAlignment="Center"
                                                Background="{Binding IsSpeakerActive, Converter={StaticResource ChannelBg}}"
                                                CornerRadius="5"
                                                ToolTip="Green = playing in the current mode">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Foreground="{Binding IsSpeakerActive, Converter={StaticResource ChannelFg}}"
                                                    Text="{Binding Label}" />
                                            </Border>
                                            <Slider
                                                Grid.Column="1"
                                                Margin="8,0"
                                                VerticalAlignment="Center"
                                                IsMoveToPointEnabled="True"
                                                LargeChange="0.5"
                                                Maximum="12"
                                                Minimum="-12"
                                                SmallChange="0.5"
                                                Tag="{Binding Label}"
                                                TickFrequency="3"
                                                ValueChanged="OnChannelLevelChanged"
                                                Value="{Binding LevelDb, Mode=TwoWay}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                Text="{Binding LevelDb, StringFormat='{}{0:+0.#;-0.#;0} dB'}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                Margin="0,10,0,0"
                                FontSize="12"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="Connect the receiver to see the active channels."
                                TextWrapping="Wrap"
                                Visibility="{Binding ActiveChannels.Count, Converter={StaticResource ZeroToVisible}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right column: tone + subwoofer -->
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <Border Margin="0,0,0,12" Padding="18" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="Tone control" />
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding State.ToneControlEnabled, Mode=TwoWay}" />
                        </Grid>

                        <TextBlock FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Text="BASS" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="58" />
                            </Grid.ColumnDefinitions>
                            <Slider
                                IsEnabled="{Binding State.ToneControlEnabled}"
                                LargeChange="1"
                                Maximum="6"
                                Minimum="-6"
                                SmallChange="1"
                                TickFrequency="1"
                                Value="{Binding State.Bass, Mode=TwoWay, Delay=200}" />
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="{Binding State.Bass, StringFormat='{}{0:+0;-0;0} dB'}" />
                        </Grid>

                        <TextBlock FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Text="TREBLE" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="58" />
                            </Grid.ColumnDefinitions>
                            <Slider
                                IsEnabled="{Binding State.ToneControlEnabled}"
                                LargeChange="1"
                                Maximum="6"
                                Minimum="-6"
                                SmallChange="1"
                                TickFrequency="1"
                                Value="{Binding State.Treble, Mode=TwoWay, Delay=200}" />
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="{Binding State.Treble, StringFormat='{}{0:+0;-0;0} dB'}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,0,0,12" Padding="18" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="Subwoofer" />
                            <!-- Sub pre-out on/off, on models that report PSSWR -->
                            <ui:ToggleSwitch
                                Grid.Column="1"
                                IsChecked="{Binding State.Settings.ByKey[swr].IsOn, Mode=TwoWay}"
                                ToolTip="Subwoofer output on / off"
                                Visibility="{Binding State.Settings.ByKey[swr].IsSupported, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                        <TextBlock Margin="0,2,0,10" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" Text="Subwoofer output (0.5 dB steps)" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="58" />
                            </Grid.ColumnDefinitions>
                            <Slider
                                LargeChange="0.5"
                                Maximum="12"
                                Minimum="-12"
                                SmallChange="0.5"
                                TickFrequency="3"
                                Value="{Binding State.SubwooferLevel, Mode=TwoWay, Delay=200}" />
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="{Binding State.SubwooferLevel, StringFormat='{}{0:+0.#;-0.#;0} dB'}" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </Grid>
</pages:PageBase>
