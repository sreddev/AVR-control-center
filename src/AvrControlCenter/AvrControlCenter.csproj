<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>AvrControlCenter</RootNamespace>
    <AssemblyName>AVRControlCenter</AssemblyName>
    <Product>AVR Control Center</Product>
    <Version>3.0.3</Version>
    <Authors>Sergio (@sreddev)</Authors>
    <Company>sreddev</Company>
    <Description>AVR Control Center — Remote control for Denon and Marantz AVR receivers on Windows. Real-time telnet monitoring, channel matrix, per-speaker trim, system tray widget, auto-discovery.</Description>
    <Copyright>© 2026 Sergio (@sreddev)</Copyright>
    <RepositoryUrl>https://github.com/sreddev/AVR-control-center</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sreddev/AVR-control-center</PackageProjectUrl>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AvrControlCenter.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*.ico" />
    <Resource Include="Assets\**\*.png" />
  </ItemGroup>

</Project>

