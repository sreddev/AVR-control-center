<Application
    x:Class="AvrControlCenter.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <!-- Swapped for Palette.Light.xaml at startup when the user picks Light -->
                <ResourceDictionary Source="/Views/Palette.Dark.xaml" />
                <ResourceDictionary Source="/Views/Theme.xaml" />
                <ResourceDictionary Source="/Controls/ChannelChip.xaml" />
                <ResourceDictionary Source="/Controls/Power.xaml" />
                <ResourceDictionary Source="/Views/SettingTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
